<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Anduin.PhotoRanking</AssemblyName>
    <RootNamespace>Anduin.PhotoRanking</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.DbTools.Sqlite" Version="10.0.32" />
    <PackageReference Include="Aiursoft.WebTools" Version="10.0.14" />
    <PackageReference Include="Aiursoft.Canon" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="models\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="NpmInstall" BeforeTargets="AngularBuild" Condition="'$(NG_SKIP_BUILD)' != 'True'">
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec Command="npm install" WorkingDirectory="../Anduin.PhotoRanking.Angular" />
  </Target>
  <Target Name="AngularBuild" BeforeTargets="Build" Condition="'$(NG_SKIP_BUILD)' != 'True'">
    <Message Importance="high" Text="Building Angular application..." />
    <Exec Command="npm run build" WorkingDirectory="../Anduin.PhotoRanking.Angular" EnvironmentVariables="NG_CLI_ANALYTICS=false" />
    <ItemGroup>
      <OldBuildFiles Include="wwwroot/main-*.js;wwwroot/polyfills-*.js;wwwroot/styles-*.css"></OldBuildFiles>
    </ItemGroup>
    <Delete Files="@(OldBuildFiles)"></Delete>
    <ItemGroup>
      <AngularBuildFiles Include="../Anduin.PhotoRanking.Angular/dist/Anduin.PhotoRanking.Angular/browser/**/*"></AngularBuildFiles>
    </ItemGroup>
    <Copy SourceFiles="@(AngularBuildFiles)" DestinationFolder="wwwroot/dist/%(RecursiveDir)"></Copy>
  </Target>
</Project>
